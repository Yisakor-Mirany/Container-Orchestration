# ContainerOps Dashboard - example configuration
# Copy to .env and adjust if needed:  cp .env.example .env
# No secrets are required to run this project. Never commit a real .env file.

# --- Docker Compose project ---
COMPOSE_PROJECT_NAME=container-orchestration

# --- Application (web service) ---
APP_NAME=ContainerOps Dashboard
APP_ENV=production
# Note: the container port is fixed at 3000 in compose.yaml because
# nginx/nginx.conf proxies to web:3000. Change both together if needed.
# Max time (ms) to drain connections on SIGTERM/SIGINT before forcing exit
SHUTDOWN_TIMEOUT_MS=10000

# --- Orchestration ---
# Number of web replicas started by "docker compose up -d"
WEB_REPLICAS=3

# --- Nginx (public entry point) ---
# Host interface and port that publish Nginx. 127.0.0.1 keeps the stack
# reachable only from this machine; use 0.0.0.0 to expose it on your LAN.
HOST_BIND=127.0.0.1
HOST_PORT=8080
